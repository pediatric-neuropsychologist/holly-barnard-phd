---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PageFlowNav from "../components/PageFlowNav.astro";
import PageHeader from "../components/PageHeader.astro";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://hollybarnardphd.com",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Fees",
      item: "https://hollybarnardphd.com/fees",
    },
  ],
};

const quickGuide = [
  {
    title: "Need initial guidance?",
    detail: "Consultation",
    value: "$200",
    note: "For families or professionals who want to talk through concerns and next steps before a full evaluation.",
  },
  {
    title: "Need a focused answer?",
    detail: "Educational or psychological evaluation",
    value: "$200/hr",
    note: "Best for a narrower diagnostic question such as ADHD, ASD, or a specific learning disorder only.",
  },
  {
    title: "Need comprehensive testing?",
    detail: "Neuropsychological evaluation",
    value: "$2,000-$3,000",
    note: "Packages are organized by age so families can see the right comprehensive option more quickly.",
  },
];

const generalServices = [
  {
    name: "Consultation",
    age: "Ages 3 - Young Adult",
    price: "$200",
    description:
      "A one-hour appointment that provides parents, patients, and other professionals an opportunity to speak to Dr. Barnard in person or via telehealth to obtain basic guidance regarding their child or case.",
  },
  {
    name: "Educational or Psychological Evaluation",
    age: "Ages 3 - Young Adult",
    price: "$200/hr",
    description:
      "This flexible package answers a focused diagnostic question, such as ruling in or out ADHD, ASD, or SLD (e.g., dyslexia) only. Evaluations typically range from four ($800) to eight ($1,600) total billable hours.",
  },
  {
    name: "Forensic Evaluation (IME/IEE)",
    age: "Ages 3 - Young Adult",
    price: "$400/hr",
    description:
      "Independent Medical Evaluations (IMEs) and Independent Educational Evaluations (IEEs) are uniquely complex and billed hourly at a higher rate. Package totals are negotiated by individual case.",
  },
];

const neuropsychPackages = [
  {
    name: "Preschool Neuropsychological Evaluation",
    age: "Ages 3-5 Years",
    price: "$2,000",
    summary: "Designed for younger children who need an early developmental and diagnostic picture.",
    includes: ["Cognitive", "Motor", "Visuospatial", "Memory", "Language", "Pre-academic", "Social/emotional", "ASD testing if appropriate"],
  },
  {
    name: "Elementary Neuropsychological Evaluation",
    age: "Ages 6-12 Years",
    price: "$2,500",
    summary: "Built for school-age concerns where learning, attention, and broader functioning need a fuller review.",
    includes: ["Cognitive", "Motor", "Visuospatial", "Memory", "Language", "Academic", "Social/emotional", "ASD testing if appropriate"],
  },
  {
    name: "Adolescent and Young Adult Neuropsychological Evaluation",
    age: "Ages 13 to Young Adult",
    price: "$3,000",
    summary: "For older students and young adults who need comprehensive testing with age-appropriate academic and emotional measures.",
    includes: ["Cognitive", "Motor", "Visuospatial", "Memory", "Language", "Academic", "Social/emotional", "ASD testing if appropriate"],
  },
];
---

<BaseLayout
  pageTitle="Fees | Holly Barnard, Ph.D."
  pageDescription="Source-aligned pricing for consultations, focused evaluations, forensic evaluations, and neuropsychological packages with Dr. Barnard in Allen, Texas."
  canonical="https://hollybarnardphd.com/fees"
>
  <script type="application/ld+json" is:inline slot="head">{JSON.stringify(breadcrumbJsonLd)}</script>

  <main class="page-shell">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Fees" }]} />

    <PageHeader
      title="Fees"
      subtitle="Clear service options, age-based neuropsychological package pricing, and payment details"
    />

    <PageFlowNav
      title="Related pages"
      links={[
        { href: "/evaluation-process", label: "See the evaluation process" },
        { href: "/services/", label: "Review services" },
        { href: "/contact", label: "Contact Dr. Barnard" },
      ]}
    />

    <section class="material-shell mb-10 p-6 md:p-8" aria-labelledby="fees-overview">
      <div class="material-grid grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <div>
          <div class="eyebrow w-fit">Pricing overview</div>
          <h2 id="fees-overview" class="mt-4 text-3xl text-slate-950 md:text-4xl">Choose the level of evaluation that matches the question being asked.</h2>
          <p class="section-intro mt-4">
            Dr. Barnard offers a smaller consultation option, focused diagnostic evaluations, and comprehensive neuropsychological packages.
            Neuropsychological evaluations are organized by age group so families can quickly find the appropriate level of testing.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="material-card-subtle p-4 md:p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">When families start small</p>
              <p class="mt-3 text-sm leading-6 text-slate-700">
                Consultation and focused evaluations are often the best fit when the question is narrow and parents want clarity before committing to a broader workup.
              </p>
            </div>
            <div class="material-card-subtle p-4 md:p-5">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">When broader testing is needed</p>
              <p class="mt-3 text-sm leading-6 text-slate-700">
                Age-based neuropsychological packages are designed for more comprehensive questions involving learning, development, neurologic history, or overlapping concerns.
              </p>
            </div>
          </div>

          <div class="mt-5 rounded-[1.5rem] border border-slate-200/90 bg-white/70 px-5 py-4 text-sm leading-6 text-slate-700 shadow-sm">
            If you are unsure which option fits best, the consultation can help determine whether a focused evaluation or a comprehensive neuropsychological evaluation is the more appropriate next step.
          </div>
        </div>

        <div class="material-card-subtle p-5 md:p-6">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">At a glance</p>
          <div class="mt-4 grid gap-3">
            {quickGuide.map((item) => (
              <div class="rounded-[1.4rem] border border-slate-200/90 bg-white/90 p-4 shadow-sm">
                <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">{item.title}</p>
                <div class="mt-2 flex items-start justify-between gap-4">
                  <p class="text-lg font-semibold text-slate-950">{item.detail}</p>
                  <span class="material-chip shrink-0 font-semibold text-[#7c2447]">{item.value}</span>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-700">{item.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="material-shell mb-10 p-6 md:p-8" aria-labelledby="general-services">
      <div class="material-grid">
        <div class="max-w-3xl">
          <div class="eyebrow w-fit">General services</div>
          <h2 id="general-services" class="mt-4 text-3xl text-slate-950">Consultation, focused evaluation, and forensic options</h2>
          <p class="section-intro mt-4">
            These services are available across the age range and are best organized by the type of question being answered rather than by age.
          </p>
        </div>

        <div class="mt-8 grid gap-5 xl:grid-cols-3">
          {generalServices.map((service) => (
            <article class="material-card material-accent-bar flex h-full flex-col p-6 pl-8">
              <div class="flex items-start justify-between gap-4">
                <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">{service.age}</p>
                <span class="rounded-full border border-[#efc16b]/55 bg-[#fff7e6] px-3 py-1 text-sm font-semibold text-[#8d5a14]">
                  {service.price}
                </span>
              </div>
              <h3 class="mt-4 text-2xl text-slate-950">{service.name}</h3>
              <p class="mt-4 grow leading-7 text-slate-700">{service.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="material-shell mb-10 p-6 md:p-8" aria-labelledby="age-based-packages">
      <div class="material-grid">
        <div class="max-w-3xl">
          <div class="eyebrow w-fit">Age-based neuropsychology packages</div>
          <h2 id="age-based-packages" class="mt-4 text-3xl text-slate-950">Comprehensive testing organized by developmental stage</h2>
          <p class="section-intro mt-4">
            The neuropsychological evaluation package is the comprehensive option. Pricing increases with age because testing becomes broader and more academically detailed.
          </p>
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {neuropsychPackages.map((service) => (
            <article class="material-card flex h-full flex-col overflow-hidden p-0">
              <div class="border-b border-slate-200/90 bg-[linear-gradient(135deg,rgba(23,107,91,0.09),rgba(217,76,125,0.1))] px-6 py-5">
                <div class="flex items-start justify-between gap-4">
                  <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">{service.age}</p>
                  <p class="text-2xl font-bold text-[#b23663]">{service.price}</p>
                </div>
                <h3 class="mt-4 text-2xl text-slate-950">{service.name}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-700">{service.summary}</p>
              </div>
              <div class="flex flex-1 flex-col px-6 py-5">
                <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Typically includes</p>
                <ul class="mt-4 grid gap-2 text-sm leading-6 text-slate-700 sm:grid-cols-2 md:grid-cols-1 xl:grid-cols-2">
                  {service.includes.map((item) => (
                    <li class="rounded-xl border border-slate-200/80 bg-white/80 px-3 py-2">{item}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="material-shell mb-16 p-6 md:p-8" aria-labelledby="payment-and-insurance">
      <div class="material-grid grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="material-card p-6 md:p-7">
          <div class="eyebrow w-fit">Payment details</div>
          <h2 id="payment-and-insurance" class="mt-4 text-2xl text-slate-950">Additional services and payment schedule</h2>
          <p class="mt-4 leading-7 text-slate-700">
            All additional psychologist services provided by Dr. Barnard, such as IEP meeting attendance, therapy, and teaching,
            are billed at an hourly rate of $200/hour, including travel.
          </p>
          <ul class="mt-5 grid gap-3 text-slate-700">
            <li class="rounded-2xl border border-slate-200/85 bg-white/85 px-4 py-3">An initial deposit of $200 is due at the time of the Diagnostic Interview and is applied toward the cost of the full evaluation.</li>
            <li class="rounded-2xl border border-slate-200/85 bg-white/85 px-4 py-3">50% of the remaining balance is due on the day of Diagnostic Testing.</li>
            <li class="rounded-2xl border border-slate-200/85 bg-white/85 px-4 py-3">The final 50% is due at the time of the Feedback Session.</li>
            <li class="rounded-2xl border border-slate-200/85 bg-white/85 px-4 py-3">Dr. Barnard accepts Zelle, checks, and credit card payments. An additional fee is assessed for credit card transactions.</li>
          </ul>
        </div>

        <div class="material-card p-6 md:p-7">
          <div class="eyebrow w-fit">Insurance</div>
          <h2 class="mt-4 text-2xl text-slate-950">Out-of-network reimbursement information</h2>
          <p class="mt-4 leading-7 text-slate-700">
            In order to provide patients and their families with the attention and care they deserve, as well as the freedom to fully
            explore all diagnoses that may be impacting the patient, Dr. Barnard does not bill insurance companies directly and is not on any insurance panels.
          </p>
          <p class="mt-4 leading-7 text-slate-700">
            Dr. Barnard can provide a statement that details appointments, charges, and billing codes should a family wish to file with insurance
            for out-of-network benefits for services. If you plan to submit for reimbursement, please contact your insurance company to get information
            about your plan's benefits.
          </p>
          <div class="material-divider my-6"></div>
          <div class="rounded-[1.5rem] border border-slate-200/90 bg-[rgba(255,247,230,0.82)] p-4 text-sm leading-6 text-slate-700">
            Families planning to use out-of-network benefits should verify coverage details with their insurer before the evaluation begins.
          </div>
        </div>
      </div>
    </section>

    <ContactCTA />
  </main>
</BaseLayout>

