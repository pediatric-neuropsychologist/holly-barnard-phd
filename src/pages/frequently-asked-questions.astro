---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  pageTitle="FAQ | Holly Barnard, Ph.D."
  pageDescription="This page has moved to the FAQ page."
  canonical="https://hollybarnardphd.com/faq"
  noindex={true}
>
  <main class="page-shell">
    <section class="material-shell p-8 md:p-10">
      <div class="material-grid max-w-3xl">
        <h1 class="text-3xl text-slate-950 md:text-4xl">FAQ page updated</h1>
        <p class="mt-4 text-lg leading-8 text-slate-700">Frequently asked questions now live at a shorter, clearer URL.</p>
        <div class="mt-6">
          <a href="/faq" class="button-primary">Go to FAQ</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>