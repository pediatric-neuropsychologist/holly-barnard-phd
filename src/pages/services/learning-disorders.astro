---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageFlowNav from "../../components/PageFlowNav.astro";
import PageHeader from "../../components/PageHeader.astro";

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://hollybarnardphd.com/services/learning-disorders#service",
      name: "Learning Disorders Assessment",
      description: "Comprehensive evaluations for specific learning disorders in reading, math, and written expression, providing targeted intervention strategies and educational accommodations.",
      serviceType: "Neuropsychological Evaluation",
      provider: { "@id": "https://hollybarnardphd.com/#medicalpractice" },
      areaServed: ["Allen, TX", "Plano, TX", "Richardson, TX", "Dallas, TX"],
      audience: {
        "@type": "PeopleAudience",
        suggestedMinAge: 3,
      },
      url: "https://hollybarnardphd.com/services/learning-disorders",
    },
    {
      "@type": "MedicalWebPage",
      "@id": "https://hollybarnardphd.com/services/learning-disorders#medicalwebpage",
      url: "https://hollybarnardphd.com/services/learning-disorders",
      name: "Learning Disorders Services | Holly Barnard, Ph.D.",
      about: { "@id": "https://hollybarnardphd.com/services/learning-disorders#service" },
      mainEntity: { "@id": "https://hollybarnardphd.com/services/learning-disorders#service" },
    },
  ],
};
---

<BaseLayout
  pageTitle="Learning Disorders Services | Holly Barnard, Ph.D."
  pageDescription="Assessments for specific learning disorders in reading, math, and written expression with practical recommendations for school supports."
  canonical="https://hollybarnardphd.com/services/learning-disorders"
>
  <script type="application/ld+json" is:inline slot="head">{JSON.stringify(serviceJsonLd)}</script>

  <main class="page-shell">
    <Breadcrumbs
      items={[
        { href: "/", label: "Home" },
        { href: "/services/", label: "Services" },
        { label: "Learning Disorders" },
      ]}
    />

    <PageHeader
      title="Specific Learning Disorders"
      subtitle="Assessments for reading, math, writing, and related learning challenges with school-focused recommendations for next steps."
    />

    <PageFlowNav
      title="Helpful next steps"
      links={[
        { href: "/evaluation-process", label: "See the evaluation process" },
        { href: "/fees", label: "Review fees" },
        { href: "/contact", label: "Contact Dr. Barnard" },
      ]}
    />

    <article class="service-stack">
      <section class="material-shell service-section">
        <div class="material-grid">
          <span class="eyebrow mb-4 w-fit">When families are concerned about academic progress</span>
          <p class="section-intro">
            Learning disorder assessments identify specific academic skill deficits in reading, math, or written expression and provide targeted intervention strategies and educational accommodations.
          </p>
        </div>
      </section>

      <section class="material-shell service-section">
        <div class="material-grid">
          <h2 class="service-heading">Types of learning disorders</h2>
          <p class="service-copy">Specific learning disorders can affect different academic areas:</p>
          <ul class="service-list">
            <li><strong>Dyslexia</strong>: Difficulties with reading and spelling</li>
            <li><strong>Dyscalculia</strong>: Challenges with math concepts and calculations</li>
            <li><strong>Dysgraphia</strong>: Problems with writing and fine motor skills</li>
            <li><strong>Mixed learning disorders</strong>: Combination of difficulties across areas</li>
          </ul>
        </div>
      </section>

      <div class="service-grid">
        <section class="material-card service-section">
          <h2 class="service-heading">Comprehensive evaluation process</h2>
          <p class="service-copy">Dr. Barnard's learning disorder assessments include:</p>
          <ul class="service-list">
            <li>Academic skill testing in reading, math, and writing</li>
            <li>Cognitive ability assessment</li>
            <li>Processing speed and memory evaluation</li>
            <li>Review of educational history and progress</li>
            <li>Observation of learning strategies</li>
          </ul>
        </section>

        <section class="material-card service-section">
          <h2 class="service-heading">What Dr. Barnard assesses</h2>
          <p class="service-copy">The evaluation examines:</p>
          <ul class="service-list">
            <li>Phonological processing and decoding skills</li>
            <li>Reading comprehension and fluency</li>
            <li>Mathematical reasoning and calculation abilities</li>
            <li>Written expression and spelling</li>
            <li>Executive functioning related to learning</li>
          </ul>
        </section>
      </div>

      <section class="material-shell service-section">
        <div class="material-grid">
          <h2 class="service-heading">School support and accommodations</h2>
          <p class="service-copy">Dr. Barnard's reports include specific recommendations for:</p>
          <ul class="service-list">
            <li>Individualized Education Program (IEP) development</li>
            <li>504 Plan accommodations</li>
            <li>Evidence-based intervention strategies</li>
            <li>Technology and assistive tools</li>
            <li>Progress monitoring approaches</li>
          </ul>
        </div>
      </section>

      <nav class="material-shell service-section" aria-label="Related services">
        <div class="material-grid">
          <h2 class="service-heading">Related services</h2>
          <p class="service-copy">Learning disorders often co-occur with other conditions.</p>
          <div class="service-link-list">
            <a class="page-flow-link" href="/services/adhd-testing">ADHD Testing</a>
            <a class="page-flow-link" href="/services/asd-assessment">ASD Assessment</a>
            <a class="page-flow-link" href="/evaluation-process">Complete Evaluation Process</a>
          </div>
        </div>
      </nav>

      <section class="material-shell service-section">
        <div class="material-grid service-cta-row">
          <div>
            <h2 class="service-heading">Schedule an assessment</h2>
            <p class="service-copy">
              If your child is struggling academically despite effort, a learning disorder evaluation can provide clarity and direction.
            </p>
          </div>
          <a href="/contact" class="button-primary">Schedule consultation</a>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>




