---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  pageTitle="Fees | Holly Barnard, Ph.D."
  pageDescription="This page has moved to the fees page."
  canonical="https://hollybarnardphd.com/fees"
  noindex={true}
>
  <main class="page-shell">
    <section class="material-shell p-8 md:p-10">
      <div class="material-grid max-w-3xl">
        <h1 class="text-3xl text-slate-950 md:text-4xl">Fees page updated</h1>
        <p class="mt-4 text-lg leading-8 text-slate-700">Pricing information now lives at a shorter, clearer URL.</p>
        <div class="mt-6">
          <a href="/fees" class="button-primary">Go to Fees</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>