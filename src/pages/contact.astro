---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageFlowNav from "../components/PageFlowNav.astro";
import PageHeader from "../components/PageHeader.astro";

const contactJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://hollybarnardphd.com/contact#contactpage",
      url: "https://hollybarnardphd.com/contact",
      name: "Contact Dr. Holly Barnard",
      mainEntity: { "@id": "https://hollybarnardphd.com/#medicalpractice" },
    },
    {
      "@type": "PostalAddress",
      "@id": "https://hollybarnardphd.com/contact#address",
      streetAddress: "1506 N. Greenville Ave., Suite 210",
      addressLocality: "Allen",
      addressRegion: "TX",
      postalCode: "75002",
      addressCountry: "US",
    },
  ],
};

const googleMapsDirections = "https://www.google.com/maps/search/?api=1&query=1506+N+Greenville+Ave+Suite+210+Allen+TX+75002";
const googleMapsEmbed = "https://maps.google.com/maps?q=1506%20N.%20Greenville%20Ave.%2C%20Suite%20210%2C%20Allen%2C%20TX%2075002&z=15&output=embed";
---

<BaseLayout
  pageTitle="Contact Dr. Holly Barnard - Pediatric Neuropsychologist"
  pageDescription="Contact information for Dr. Holly Barnard, pediatric neuropsychologist in Allen, TX. Reach out for a free phone or e-mail consultation to determine whether the practice is a good fit for your child."
  canonical="https://hollybarnardphd.com/contact"
>
  <script type="application/ld+json" is:inline slot="head">{JSON.stringify(contactJsonLd)}</script>
  <main class="page-shell">
    <Breadcrumbs items={[{ href: "/", label: "Home" }, { label: "Contact" }]} />

    <PageHeader
      title="Contact Dr. Barnard"
      subtitle="Free phone or e-mail consultation to determine whether the practice is a good fit for your child"
    />

    <PageFlowNav
      title="Helpful next steps"
      links={[
        { href: "/services/", label: "Learn about the practice" },
        { href: "/evaluation-process", label: "See the evaluation process" },
        { href: "/fees", label: "Review fees" },
      ]}
    />


    <section
      class="material-shell mb-10 p-4 md:p-6"
      itemscope
      itemtype="https://schema.org/MedicalBusiness"
      itemid="https://hollybarnardphd.com/#medicalpractice"
    >
      <div class="material-grid grid gap-6 lg:grid-cols-[0.95fr_1.15fr] lg:items-stretch">
        <section class="material-card flex flex-col p-6 md:p-8">
          <div class="eyebrow mb-4 w-fit">Location & Contact</div>
          <h2 class="text-3xl text-slate-950">Office information</h2>
          <p class="mt-4 text-base leading-7 text-slate-700">
            The office is located in Allen, Texas. Use the map to view the location and get directions before your visit.
          </p>

          <div class="material-divider my-6"></div>

          <address
            class="not-italic text-slate-700"
            itemprop="address"
            itemscope
            itemtype="https://schema.org/PostalAddress"
          >
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Office address</p>
            <p class="mt-2 text-lg font-semibold text-slate-950">
              <span itemprop="streetAddress">1506 N. Greenville Ave., Suite 210</span>
            </p>
            <p class="mt-1 text-base text-slate-700">
              <span itemprop="addressLocality">Allen</span>, <span itemprop="addressRegion">TX</span>
              <span itemprop="postalCode">75002</span>
            </p>
          </address>

          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200/90 bg-white/80 p-4 shadow-sm">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Phone</p>
              <a href="tel:12142718018" class="mt-2 inline-flex text-lg font-semibold text-[#b23663] hover:underline" itemprop="telephone">
                (214) 271-8018
              </a>
            </div>
            <div class="rounded-2xl border border-slate-200/90 bg-white/80 p-4 shadow-sm">
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Email</p>
              <a href="mailto:contact@hollybarnardphd.com" class="mt-2 inline-flex break-all text-lg font-semibold text-[#b23663] hover:underline" itemprop="email">
                contact@hollybarnardphd.com
              </a>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={googleMapsDirections} target="_blank" rel="noreferrer" class="button-primary">Get directions</a>
            <a href="tel:+12142718018" class="button-secondary">Call the office</a>
          </div>
        </section>

        <section class="material-card overflow-hidden p-3 md:p-4" aria-label="Office map">
          <div class="relative overflow-hidden rounded-[1.5rem] border border-slate-200/80 bg-slate-100 shadow-sm">
            <iframe
              title="Map to Dr. Holly Barnard's office in Allen, Texas"
              src={googleMapsEmbed}
              class="h-[320px] w-full md:h-[420px]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
          <div class="mt-4 flex items-center justify-between gap-4 rounded-2xl border border-slate-200/80 bg-white/80 p-4">
            <div>
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Google Maps</p>
              <p class="mt-1 text-sm leading-6 text-slate-700">Open the listing in Google Maps for directions and a larger map view.</p>
            </div>
            <a href={googleMapsDirections} target="_blank" rel="noreferrer" class="page-flow-link whitespace-nowrap">Open map</a>
          </div>
        </section>
      </div>
    </section>
    
  </main>
</BaseLayout>
