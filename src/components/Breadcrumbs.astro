---
export interface Crumb {
  href?: string;
  label: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && <span aria-hidden="true" class="text-slate-400">/</span>}
          {item.href && index !== items.length - 1 ? (
            <a href={item.href} class="breadcrumbs-link">{item.label}</a>
          ) : (
            <span aria-current={index === items.length - 1 ? "page" : undefined} class="font-semibold text-slate-800">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
